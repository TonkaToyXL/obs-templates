<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nebula-vibe-desk.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_INSTALL_DIR/bridge/start-bridge.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_INSTALL_DIR/bridge/bridge.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_INSTALL_DIR/bridge/bridge.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OBS_BRIDGE_PORT</key>
    <string>8765</string>
    <key>OBS_MIC_INPUT</key>
    <string></string>
    <key>OBS_WS_PASS</key>
    <string></string>
  </dict>
</dict>
</plist>
